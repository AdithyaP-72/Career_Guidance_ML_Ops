# Copy this file to `.env` (which is gitignored) and fill in YOUR values.
# src/models/tracking.py reads it, so every training run logs to the team's MLflow on DagsHub.
# Leave MLFLOW_TRACKING_URI empty (or delete .env) to log to a local mlflow.db instead.

MLFLOW_TRACKING_URI=https://dagshub.com/AdithyaP-72/Career_Guidance_ML_Ops.mlflow
MLFLOW_TRACKING_USERNAME=your-dagshub-username
MLFLOW_TRACKING_PASSWORD=your-dagshub-token
